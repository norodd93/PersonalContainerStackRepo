[Unit]
Description=Open WebUI
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=norod
WorkingDirectory=/var/lib/open-webui
Environment=DATA_DIR=/var/lib/open-webui
Environment=OLLAMA_BASE_URL=http://127.0.0.1:11434
Environment=ENABLE_SIGNUP=false
Environment=ENABLE_WEB_SEARCH=true
Environment=WEB_SEARCH_ENGINE=searxng
Environment=WEB_SEARCH_RESULT_COUNT=3
Environment="SEARXNG_QUERY_URL=http://127.0.0.1:8888/search?q=<query>"
ExecStart=/opt/open-webui/venv/bin/open-webui serve --host 127.0.0.1 --port 3000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
